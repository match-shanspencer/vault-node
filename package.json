{
  "name": "@match/vault",
  "type": "module",
  "version": "1.0.1",
  "description": "Vault integration for NodeJS applications using ES Modules, or CommonJS.",
  "repository": {
    "type": "git",
    "url": "https://github.com/match-shanspencer/vault-node.git"
  },
  "exports": {
    ".": {
      "import": "./dist/mjs/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "main": "dist/cjs/index.js",
  "module": "dist/mjs/index.js",
  "files": [
    "dist/**"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.2",
    "dotenv": "^16.4.5",
    "prettier": "^3.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "prebuild": "rm -rf ./dist/",
    "prepublishOnly": "yarn build",
    "build": "tsc && tsc -p tsconfig.cjs.json && node --loader ts-node/esm scripts/copy-package.js",
    "example": "node --loader ts-node/esm  ./example/index.ts"
  },
  "author": "Shan Spencer",
  "license": "ISC"
}